// # Main Entry Point & CLI Dispatcher
//
// Logline: Dispatches CLI arguments to search engine, statistics, and interactive REPL.
//
// Setup: Granted FsReadCap to load canonical JSONL corpus; parses all CLI flags.
//
// Beats:
//   1. Load canonical corpus from data/ahamkara_corpus.jsonl via repo_load_all.
//   2. Parse CLI flags: --search, --entity, --category, --quote, --stats,
//      --interactive, --limit, --help, --version, and subcommands.
//   3. Dispatch to engine_print_stats, cli_run_interactive, or engine_search.
//   4. Format and render matching records with card borders.

import "model/record.oo";
import "model/query.oo";
import "repo/loader.oo";
import "engine/search.oo";
import "engine/stats.oo";
import "cli/format.oo";
import "cli/interactive.oo";

fn parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut v: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { v = v * 10 + 0; }
        else if c == "1" { v = v * 10 + 1; }
        else if c == "2" { v = v * 10 + 2; }
        else if c == "3" { v = v * 10 + 3; }
        else if c == "4" { v = v * 10 + 4; }
        else if c == "5" { v = v * 10 + 5; }
        else if c == "6" { v = v * 10 + 6; }
        else if c == "7" { v = v * 10 + 7; }
        else if c == "8" { v = v * 10 + 8; }
        else if c == "9" { v = v * 10 + 9; }
        i = i + 1;
    }
    return v;
}

fn print_usage() {
    println("Ahamkara Lore Query Engine (openOODA)");
    println("Usage: ahamkara [--search <term>] [--entity <name>] [--category <cat>] [--quote] [--stats] [--interactive] [--limit <num>] [--help] [--version]");
    println("");
    println("Options:");
    println("  -s, --search <term>    Search lore by keyword or phrase");
    println("  -e, --entity <name>    Filter by entity (Riven, Taranis, Hefnd, etc.)");
    println("  -c, --category <cat>   Filter by category (exotics, raid_armor, etc.)");
    println("  -q, --quote            Filter to records with whisper quotations");
    println("      --limit <num>      Limit maximum number of results displayed");
    println("      --stats            Display corpus analytics and distribution");
    println("  -i, --interactive      Launch interactive lore exploration REPL");
    println("  -h, --help             Display this usage help");
    println("  -v, --version          Display version information");
}

pub fn dispatch_cli(records: List[AhamkaraRecord], args: List[String]) -> Result[Int, String] {
    let n_args: Int = list_len(args);
    if n_args == 0 {
        println("Ahamkara Lore Query Engine (openOODA)");
        println("Usage: ahamkara [--search <term>] [--entity <name>] [--category <cat>] [--quote] [--stats] [--interactive] [--limit <num>] [--help] [--version]");
        let total: Int = list_len(records);
        println("Loaded " + total.to_string() + " canonical lore entries.");
        return Ok(0);
    }

    let mut f: QueryFilter = filter_default();
    let mut show_stats: Bool = false;
    let mut run_inter: Bool = false;
    let mut show_help: Bool = false;
    let mut show_ver: Bool = false;

    let mut i: Int = 0;
    while i < n_args {
        let arg: String = list_get(args, i);
        if arg == "--search" || arg == "-s" || arg == "--keyword" {
            if i + 1 < n_args {
                f.keyword = list_get(args, i + 1);
                i = i + 2;
            } else {
                i = i + 1;
            }
        } else if arg == "--entity" || arg == "-e" {
            if i + 1 < n_args {
                f.entity = list_get(args, i + 1);
                i = i + 2;
            } else {
                i = i + 1;
            }
        } else if arg == "--category" || arg == "-c" {
            if i + 1 < n_args {
                f.category = list_get(args, i + 1);
                i = i + 2;
            } else {
                i = i + 1;
            }
        } else if arg == "--quote" || arg == "-q" {
            f.has_quote = true;
            i = i + 1;
        } else if arg == "--limit" {
            if i + 1 < n_args {
                f.limit = parse_int(list_get(args, i + 1));
                i = i + 2;
            } else {
                i = i + 1;
            }
        } else if arg == "--stats" || arg == "stats" {
            show_stats = true;
            i = i + 1;
        } else if arg == "--interactive" || arg == "-i" || arg == "interactive" {
            run_inter = true;
            i = i + 1;
        } else if arg == "--help" || arg == "-h" || arg == "help" {
            show_help = true;
            i = i + 1;
        } else if arg == "--version" || arg == "-v" || arg == "version" {
            show_ver = true;
            i = i + 1;
        } else if arg == "query" {
            i = i + 1;
        } else {
            if chars_len(f.keyword) == 0 && chars_len(arg) > 0 && char_at(arg, 0) != "-" {
                f.keyword = arg;
            }
            i = i + 1;
        }
    }

    if show_help {
        print_usage();
        return Ok(0);
    }
    if show_ver {
        println("ahamkara 0.5.1 (openOODA)");
        return Ok(0);
    }
    if show_stats {
        engine_print_stats(records);
        return Ok(0);
    }
    if run_inter {
        cli_run_interactive(records);
        return Ok(0);
    }

    let results: List[AhamkaraRecord] = engine_search(records, f);
    let count: Int = list_len(results);
    println("Found " + count.to_string() + " matching records.\n");

    let mut ri: Int = 0;
    while ri < count {
        let r: AhamkaraRecord = list_get(results, ri);
        print_record_card(r);
        ri = ri + 1;
    }
    return Ok(0);
}

pub fn main(fs: &FsReadCap, args: List[String]) -> Result[Int, String] {
    let mut corpus_path: String = "data/ahamkara_corpus.jsonl";
    if !path_exists(fs, corpus_path) {
        if path_exists(fs, "../data/ahamkara_corpus.jsonl") {
            corpus_path = "../data/ahamkara_corpus.jsonl";
        }
    }
    let load_res: Result[List[AhamkaraRecord], String] = repo_load_all(fs, corpus_path);
    if load_res.is_err() {
        let err_msg: String = match load_res {
            Ok(_) => "",
            Err(e) => e
        };
        println("ERROR: " + err_msg);
        return Err(err_msg);
    }

    match load_res {
        Ok(records) => {
            return dispatch_cli(records, args);
        },
        Err(e) => {
            return Err(e);
        }
    };
}
