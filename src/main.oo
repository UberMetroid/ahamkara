// # Main Entry Point & CLI Dispatcher
//
// Logline: Dispatches CLI arguments to search engine, statistics, and interactive REPL.
//
// Setup: Granted FsReadCap to seed relational database and route queries through db contract.
//
// Beats:
//   1. Initialize DbTable via db_contract_init and seed via repo_seed_table.
//   2. Hydrate records via db_contract_select_all.
//   3. Parse CLI flags: --search, --entity, --category, --quote, --stats,
//      --interactive, --limit, --id, --theme, --chronology, --help, --version.
//   4. Dispatch to engine_print_stats, cli_run_interactive, or engine_search.
//   5. Format and render matching records with card borders.

import "model/record.oo";
import "model/query.oo";
import "repo/loader.oo";
import "repo/db_contract.oo";
import "engine/search.oo";
import "engine/stats.oo";
import "cli/format.oo";
import "cli/interactive.oo";

fn print_usage() {
    println("Ahamkara Lore Query Engine (openOODA)");
    println("Usage: ahamkara [--search <term>] [--entity <name>] [--category <cat>] [--quote] [--stats] [--interactive] [--limit <num>] [--help] [--version]");
    println("");
    println("Options:");
    println("  -s, --search <term>    Search lore by keyword or phrase");
    println("  -e, --entity <name>    Filter by entity (Riven, Taranis, Hefnd, etc.)");
    println("  -c, --category <cat>   Filter by category (exotics, raid_armor, etc.)");
    println("  -q, --quote            Filter to records with whisper quotations");
    println("      --id <id>          Lookup record by exact unique identifier");
    println("      --theme <theme>    Filter records by theme");
    println("      --chronology <chr> Filter records by chronology or era");
    println("      --limit <num>      Limit maximum number of results displayed");
    println("      --stats            Display corpus analytics and distribution");
    println("  -i, --interactive      Launch interactive lore exploration REPL");
    println("  -h, --help             Display this usage help");
    println("  -v, --version          Display version information");
}

pub fn dispatch_cli(records: List[AhamkaraRecord], args: List[String]) -> Result[Int, String] {
    let n_args: Int = list_len(args);
    if n_args == 0 {
        println("Ahamkara Lore Query Engine (openOODA)");
        println("Usage: ahamkara [--search <term>] [--entity <name>] [--category <cat>] [--quote] [--stats] [--interactive] [--limit <num>] [--help] [--version]");
        let total: Int = db_contract_count(records);
        println("Loaded " + total.to_string() + " canonical lore entries.");
        return Ok(0);
    }

    let mut f: QueryFilter = filter_default();
    let mut target_id: String = "";
    let mut show_stats: Bool = false;
    let mut run_inter: Bool = false;
    let mut show_help: Bool = false;
    let mut show_ver: Bool = false;

    let mut i: Int = 0;
    while i < n_args {
        let arg: String = list_get(args, i);
        if arg == "--search" || arg == "-s" || arg == "--keyword" {
            if i + 1 < n_args { f.keyword = list_get(args, i + 1); i = i + 2; }
            else { println("Error: missing argument for " + arg); print_usage(); return Ok(2); }
        } else if arg == "--entity" || arg == "-e" {
            if i + 1 < n_args { f.entity = list_get(args, i + 1); i = i + 2; }
            else { println("Error: missing argument for " + arg); print_usage(); return Ok(2); }
        } else if arg == "--category" || arg == "-c" {
            if i + 1 < n_args { f.category = list_get(args, i + 1); i = i + 2; }
            else { println("Error: missing argument for " + arg); print_usage(); return Ok(2); }
        } else if arg == "--id" {
            if i + 1 < n_args { target_id = list_get(args, i + 1); i = i + 2; }
            else { println("Error: missing argument for --id"); print_usage(); return Ok(2); }
        } else if arg == "--theme" {
            if i + 1 < n_args {
                let thm: String = list_get(args, i + 1);
                if chars_len(f.category) == 0 { f.category = thm; } else { f.keyword = thm; }
                i = i + 2;
            } else { println("Error: missing argument for --theme"); print_usage(); return Ok(2); }
        } else if arg == "--chronology" {
            if i + 1 < n_args {
                let chr: String = list_get(args, i + 1);
                if chars_len(f.keyword) == 0 { f.keyword = chr; } else { f.category = chr; }
                i = i + 2;
            } else { println("Error: missing argument for --chronology"); print_usage(); return Ok(2); }
        } else if arg == "--quote" || arg == "-q" {
            f.has_quote = true;
            i = i + 1;
        } else if arg == "--limit" {
            if i + 1 < n_args {
                let lim_str: String = list_get(args, i + 1);
                if has_digit(lim_str) {
                    let lim_val: Int = parse_int(lim_str);
                    if lim_val < 0 {
                        println("Error: limit must be a non-negative integer: " + lim_str);
                        print_usage();
                        return Ok(2);
                    }
                    f.limit = lim_val;
                    f.has_explicit_limit = true;
                }
                i = i + 2;
            } else {
                println("Error: missing argument for --limit");
                print_usage();
                return Ok(2);
            }
        } else if arg == "--stats" || arg == "stats" {
            show_stats = true;
            i = i + 1;
        } else if arg == "--interactive" || arg == "-i" || arg == "interactive" {
            run_inter = true;
            i = i + 1;
        } else if arg == "--help" || arg == "-h" || arg == "help" {
            show_help = true;
            i = i + 1;
        } else if arg == "--version" || arg == "-v" || arg == "version" {
            show_ver = true;
            i = i + 1;
        } else if arg == "query" {
            i = i + 1;
        } else if chars_len(arg) > 0 && char_at(arg, 0) == "-" {
            println("Unrecognized option: " + arg);
            print_usage();
            return Ok(2);
        } else {
            if chars_len(f.keyword) == 0 && chars_len(arg) > 0 { f.keyword = arg; }
            i = i + 1;
        }
    }

    if show_help {
        print_usage();
        return Ok(0);
    }
    if show_ver {
        println("ahamkara 1.1.0 (openOODA)");
        return Ok(0);
    }
    if show_stats {
        engine_print_stats(records);
        return Ok(0);
    }
    if run_inter {
        cli_run_interactive(records);
        return Ok(0);
    }
    if chars_len(target_id) > 0 {
        let opt: Option[AhamkaraRecord] = db_contract_find_by_id(records, target_id);
        match opt {
            Some(r) => {
                println("Found 1 matching records.\n");
                print_record_card(r);
                return Ok(0);
            },
            None => {
                println("Found 0 matching records.\n");
                return Ok(0);
            }
        };
    }

    let results: List[AhamkaraRecord] = engine_search(records, f);
    let count: Int = list_len(results);
    println("Found " + count.to_string() + " matching records.\n");

    let mut ri: Int = 0;
    while ri < count {
        let r: AhamkaraRecord = list_get(results, ri);
        print_record_card(r);
        ri = ri + 1;
    }
    return Ok(0);
}

pub fn main(fs: &FsReadCap, args: List[String]) -> Result[Int, String] {
    let n_args: Int = list_len(args);
    let mut check_idx: Int = 0;
    while check_idx < n_args {
        let a: String = list_get(args, check_idx);
        if a == "--help" || a == "-h" || a == "help" { print_usage(); return Ok(0); }
        if a == "--version" || a == "-v" || a == "version" { println("ahamkara 1.1.0 (openOODA)"); return Ok(0); }
        check_idx = check_idx + 1;
    }

    let mut corpus_path: String = "data/ahamkara_corpus.jsonl";
    if !path_exists(fs, corpus_path) {
        if path_exists(fs, "../data/ahamkara_corpus.jsonl") {
            corpus_path = "../data/ahamkara_corpus.jsonl";
        }
    }

    let mut db: DbTable = db_contract_init();
    let seed_res: Result[Int, String] = repo_seed_table(fs, &mut db, corpus_path);
    if seed_res.is_err() {
        let err_msg: String = match seed_res {
            Ok(_) => "",
            Err(e) => e
        };
        println("ERROR: " + err_msg);
        return Err(err_msg);
    }

    let records: List[AhamkaraRecord] = db_contract_select_all(&mut db);
    return dispatch_cli(records, args);
}
