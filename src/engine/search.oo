// # Core Search and Filtering Engine
//
// Logline: Multi-attribute search and case-insensitive query matching over Ahamkara records.
//
// Setup: Pure data processing. Strictly 0 filesystem operations.
//
// Beats:
//   1. contains_ic: Case-insensitive, whitespace-trimmed substring search.
//   2. record_matches_filter: Multi-attribute filter (keyword, entity, category, quote, limit).
//   3. engine_search: Primary search query engine returning matching List[AhamkaraRecord].
//   4. Convenience query helpers: search_query, search_keyword, search_entity, search_category.

import "model/record.oo";
import "model/query.oo";

fn replace_space_with_underscore(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " {
            out = out + "_";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn contains_ic(haystack: String, needle: String) -> Bool {
    let n_clean: String = trim(needle);
    if chars_len(n_clean) == 0 {
        return true;
    }
    if chars_len(haystack) == 0 {
        return false;
    }
    let h: String = to_lowercase(haystack);
    let n: String = to_lowercase(n_clean);
    return str_contains(h, n);
}

pub fn record_matches_filter(r: AhamkaraRecord, f: QueryFilter) -> Bool {
    // 1. Entity filter (checks entity field and tags for joint records like Huginn & Muninn)
    let ent_clean: String = trim(f.entity);
    if chars_len(ent_clean) > 0 {
        let mut ent_hit: Bool = contains_ic(r.entity, ent_clean);
        if !ent_hit {
            let n_tags: Int = list_len(r.tags);
            let mut ti: Int = 0;
            while ti < n_tags && !ent_hit {
                if contains_ic(list_get(r.tags, ti), ent_clean) {
                    ent_hit = true;
                }
                ti = ti + 1;
            }
        }
        if !ent_hit {
            return false;
        }
    }

    // 2. Category filter (checks category, source, and tags; normalizes spaces and underscores)
    let cat_clean: String = trim(f.category);
    if chars_len(cat_clean) > 0 {
        let cat_norm: String = replace_space_with_underscore(to_lowercase(cat_clean));
        let mut cat_hit: Bool = contains_ic(r.category, cat_clean) || contains_ic(r.category, cat_norm) || contains_ic(r.source, cat_clean);
        if !cat_hit {
            let n_tags: Int = list_len(r.tags);
            let mut ti: Int = 0;
            while ti < n_tags && !cat_hit {
                if contains_ic(list_get(r.tags, ti), cat_clean) || contains_ic(list_get(r.tags, ti), cat_norm) {
                    cat_hit = true;
                }
                ti = ti + 1;
            }
        }
        if !cat_hit {
            return false;
        }
    }

    // 3. Whisper / Quote filter
    if f.has_quote {
        if chars_len(r.quote) == 0 {
            return false;
        }
    }

    // 4. Keyword search across title, lore_text, quote, source, entity, and tags
    let kw_clean: String = trim(f.keyword);
    if chars_len(kw_clean) > 0 {
        let hit_title: Bool = contains_ic(r.title, kw_clean);
        let hit_lore: Bool = contains_ic(r.lore_text, kw_clean);
        let hit_quote: Bool = contains_ic(r.quote, kw_clean);
        let hit_source: Bool = contains_ic(r.source, kw_clean);
        let hit_entity: Bool = contains_ic(r.entity, kw_clean);
        let hit_cat: Bool = contains_ic(r.category, kw_clean);
        let mut hit_tags: Bool = false;
        let n_tags: Int = list_len(r.tags);
        let mut ti: Int = 0;
        while ti < n_tags && !hit_tags {
            if contains_ic(list_get(r.tags, ti), kw_clean) {
                hit_tags = true;
            }
            ti = ti + 1;
        }
        if !hit_title && !hit_lore && !hit_quote && !hit_source && !hit_entity && !hit_cat && !hit_tags {
            return false;
        }
    }

    return true;
}

pub fn engine_search(records: List[AhamkaraRecord], f: QueryFilter) -> List[AhamkaraRecord] {
    let mut out: List[AhamkaraRecord] = list_new();
    let n: Int = list_len(records);
    let mut i: Int = 0;
    while i < n {
        let r: AhamkaraRecord = list_get(records, i);
        if record_matches_filter(r, f) {
            out = list_push(out, r);
            if f.limit > 0 && list_len(out) >= f.limit {
                return out;
            }
        }
        i = i + 1;
    }
    return out;
}

pub fn search_query(records: List[AhamkaraRecord], filter: QueryFilter) -> List[AhamkaraRecord] {
    return engine_search(records, filter);
}

pub fn search_keyword(records: List[AhamkaraRecord], kw: String) -> List[AhamkaraRecord] {
    let mut f: QueryFilter = filter_default();
    f.keyword = kw;
    return engine_search(records, f);
}

pub fn search_entity(records: List[AhamkaraRecord], ent: String) -> List[AhamkaraRecord] {
    let mut f: QueryFilter = filter_default();
    f.entity = ent;
    return engine_search(records, f);
}

pub fn search_category(records: List[AhamkaraRecord], cat: String) -> List[AhamkaraRecord] {
    let mut f: QueryFilter = filter_default();
    f.category = cat;
    return engine_search(records, f);
}
