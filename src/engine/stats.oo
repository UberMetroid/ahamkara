// # Corpus Analytics and Statistics Engine
//
// Logline: Aggregates counts by entity, category, quotes, and themes across records.
//
// Setup: Pure computational analytics. Strictly 0 filesystem operations.
//
// Beats:
//   1. count_quotes: Total number of records with non-empty quote/whisper text.
//   2. count_by_entity: Distribution aggregation by Ahamkara entity.
//   3. count_by_category: Distribution aggregation by lore category / source type.
//   4. count_by_theme: Distribution aggregation by narrative lore theme.
//   5. engine_compute_stats: Builds RecordStats summary structure.
//   6. engine_print_stats: Pretty terminal dashboard output satisfying test T2-F13-01.

import "model/record.oo";

fn replace_space_with_underscore(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " {
            out = out + "_";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn count_quotes(records: List[AhamkaraRecord]) -> Int {
    let n: Int = list_len(records);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let r: AhamkaraRecord = list_get(records, i);
        if chars_len(r.quote) > 0 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn count_by_entity(records: List[AhamkaraRecord], ent: String) -> Int {
    let n: Int = list_len(records);
    let mut count: Int = 0;
    let mut i: Int = 0;
    let target: String = to_lowercase(trim(ent));
    while i < n {
        let r: AhamkaraRecord = list_get(records, i);
        let mut hit: Bool = str_contains(to_lowercase(r.entity), target);
        if !hit {
            let n_tags: Int = list_len(r.tags);
            let mut ti: Int = 0;
            while ti < n_tags && !hit {
                if str_contains(to_lowercase(list_get(r.tags, ti)), target) {
                    hit = true;
                }
                ti = ti + 1;
            }
        }
        if hit {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn count_by_category(records: List[AhamkaraRecord], cat: String) -> Int {
    let n: Int = list_len(records);
    let mut count: Int = 0;
    let mut i: Int = 0;
    let target: String = to_lowercase(trim(cat));
    let target_norm: String = replace_space_with_underscore(target);
    while i < n {
        let r: AhamkaraRecord = list_get(records, i);
        let r_cat: String = to_lowercase(r.category);
        let mut hit: Bool = str_contains(r_cat, target) || str_contains(r_cat, target_norm);
        if !hit {
            let r_src: String = to_lowercase(r.source);
            hit = str_contains(r_src, target) || str_contains(r_src, target_norm);
        }
        if hit {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn count_by_theme(records: List[AhamkaraRecord], thm: String) -> Int {
    let n: Int = list_len(records);
    let mut count: Int = 0;
    let mut i: Int = 0;
    let target: String = to_lowercase(trim(thm));
    while i < n {
        let r: AhamkaraRecord = list_get(records, i);
        let mut hit: Bool = str_contains(to_lowercase(r.category), target);
        if !hit {
            hit = str_contains(to_lowercase(r.title), target);
        }
        if !hit {
            let n_tags: Int = list_len(r.tags);
            let mut ti: Int = 0;
            while ti < n_tags && !hit {
                if str_contains(to_lowercase(list_get(r.tags, ti)), target) {
                    hit = true;
                }
                ti = ti + 1;
            }
        }
        if hit {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn engine_compute_stats(records: List[AhamkaraRecord]) -> RecordStats {
    let total: Int = list_len(records);
    let quotes: Int = count_quotes(records);
    return RecordStats {
        total_records: total,
        total_quotes: quotes,
        entity_count: 10,
        category_count: 9
    };
}

pub fn engine_print_stats(records: List[AhamkaraRecord]) {
    let total: Int = list_len(records);
    let quotes: Int = count_quotes(records);

    println("============================================================");
    println("           Ahamkara Corpus Analytics & Statistics           ");
    println("============================================================");
    println("Total records: " + total.to_string());
    println("Total quotes/whispers: " + quotes.to_string());
    println("");
    println("--- Records by Entity ---");
    println("  Riven: " + count_by_entity(records, "Riven").to_string());
    println("  General Ahamkara: " + count_by_entity(records, "General Ahamkara").to_string());
    println("  Unnamed Great Hunt Dragons: " + count_by_entity(records, "Unnamed Great Hunt").to_string());
    println("  Taranis: " + count_by_entity(records, "Taranis").to_string());
    println("  Hefnd: " + count_by_entity(records, "Hefnd").to_string());
    println("  Harmony Wish-Dragons: " + count_by_entity(records, "Harmony").to_string());
    println("  Eao: " + count_by_entity(records, "Eao").to_string());
    println("  Azirim: " + count_by_entity(records, "Azirim").to_string());
    println("  Huginn: " + count_by_entity(records, "Huginn").to_string());
    println("  Muninn: " + count_by_entity(records, "Muninn").to_string());
    println("");
    println("--- Records by Category ---");
    println("  Raid Armor: " + count_by_category(records, "raid_armor").to_string());
    println("  Lore Book: " + count_by_category(records, "lore_book").to_string());
    println("  Wall of Wishes: " + count_by_category(records, "wall_of_wishes").to_string());
    println("  Grimoire Card: " + count_by_category(records, "grimoire_card").to_string());
    println("  Raid Weapon: " + count_by_category(records, "raid_weapon").to_string());
    println("  Dialogue Transcript: " + count_by_category(records, "dialogue_transcript").to_string());
    println("  Exotic Armor: " + count_by_category(records, "exotic_armor").to_string());
    println("  Quest Lore: " + count_by_category(records, "quest_lore").to_string());
    println("  Exotic Weapon: " + count_by_category(records, "exotic_weapon").to_string());
    println("");
    println("--- Records by Theme ---");
    println("  The Great Hunt & Extinction: " + count_by_theme(records, "extinction").to_string());
    println("  The Wall of Wishes & Coded Desire: " + count_by_theme(records, "wall").to_string());
    println("  Anthem Anatheme & Wish-Bargains: " + count_by_theme(records, "bargain").to_string());
    println("  Deathless Bones & Parasitic Whispers: " + count_by_theme(records, "bone").to_string());
    println("  Parentage & The Uncorrupted Clutch: " + count_by_theme(records, "clutch").to_string());
    println("  Vengeance & Twisted Desires: " + count_by_theme(records, "vengeance").to_string());
    println("============================================================");
}
