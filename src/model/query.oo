// # Query Filter & Search Result Models
//
// Logline: Filter criteria and result structures for searching Ahamkara lore.
//
// Setup: Pure data structures. Strictly 0 I/O imports.
//
// Beats:
//   1. QueryFilter: Filter parameters for multi-attribute matching.
//   2. SearchResult: Search metadata and match counts.
//   3. Default parameter factory and constructor functions.

pub type QueryFilter = struct {
    keyword: String,
    entity: String,
    category: String,
    has_quote: Bool,
    limit: Int,
    has_explicit_limit: Bool
};

pub type SearchResult = struct {
    total_matched: Int,
    has_more: Bool,
    query_term: String
};

pub fn filter_default() -> QueryFilter {
    return QueryFilter {
        keyword: "",
        entity: "",
        category: "",
        has_quote: false,
        limit: 0,
        has_explicit_limit: false
    };
}

pub fn query_filter_default() -> QueryFilter {
    return filter_default();
}

pub fn query_default() -> QueryFilter {
    return filter_default();
}

pub fn query_filter_new(
    keyword: String,
    entity: String,
    category: String,
    has_quote: Bool,
    limit: Int
) -> QueryFilter {
    return QueryFilter {
        keyword: keyword,
        entity: entity,
        category: category,
        has_quote: has_quote,
        limit: limit,
        has_explicit_limit: true
    };
}

pub fn query_has_filter(f: QueryFilter) -> Bool {
    if chars_len(f.keyword) > 0 { return true; }
    if chars_len(f.entity) > 0 { return true; }
    if chars_len(f.category) > 0 { return true; }
    if f.has_quote { return true; }
    if f.has_explicit_limit || f.limit > 0 { return true; }
    return false;
}

pub fn search_result_new(total: Int, has_more: Bool, term: String) -> SearchResult {
    return SearchResult {
        total_matched: total,
        has_more: has_more,
        query_term: term
    };
}
