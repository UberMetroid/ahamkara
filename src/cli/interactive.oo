// # Interactive Terminal REPL and Lore Explorer
//
// Logline: Terminal REPL session for interactive Ahamkara lore discovery.
//
// Setup: Pure terminal interactive loop. Strictly 0 I/O capabilities required.
//
// Beats:
//   1. cli_run_interactive: Terminal exploration banner and menu overview.
//   2. cli_interactive_eval: REPL command dispatcher (search, find, help, quit, exit).
//   3. Browsing helpers: entity, category, whisper, stats, and list queries.

import "model/record.oo";
import "cli/format.oo";

fn ic_match(haystack: String, needle: String) -> Bool {
    let n: String = to_lowercase(trim(needle));
    if chars_len(n) == 0 { return true; }
    if chars_len(haystack) == 0 { return false; }
    let h: String = to_lowercase(haystack);
    return str_contains(h, n);
}

pub fn print_interactive_help() {
    println("Interactive REPL Commands:");
    println("  search <term>    - Search records by keyword (alias: find <term>)");
    println("  find <term>      - Search records by keyword");
    println("  entity <name>    - Browse lore by entity (Riven, Taranis, Hefnd, etc.)");
    println("  category <cat>   - Browse by category (exotic_armor, raid_armor, etc.)");
    println("  whisper          - Display paracausal whispers and quotes");
    println("  stats            - Display corpus distribution and analytics");
    println("  list             - Show compact index of canonical records");
    println("  help             - Display this interactive command guide");
    println("  quit             - Exit interactive session (alias: exit)");
    println("  exit             - Exit interactive session");
}

pub fn cli_interactive_stats(records: List[AhamkaraRecord]) {
    let total: Int = list_len(records);
    let mut quotes: Int = 0;
    let mut i: Int = 0;
    while i < total {
        let r: AhamkaraRecord = list_get(records, i);
        if chars_len(r.quote) > 0 {
            quotes = quotes + 1;
        }
        i = i + 1;
    }
    println("============================================================");
    println("           Ahamkara Corpus Analytics & Statistics           ");
    println("============================================================");
    println("Total canonical records : " + total.to_string());
    println("Total recorded whispers : " + quotes.to_string());
    println("Canonical entities      : Riven, Taranis, Hefnd, Huginn, Muninn, Azirim, Eao");
    println("Primary categories      : exotic_armor, raid_armor, lore_book, grimoire_card");
    println("============================================================");
}

pub fn cli_interactive_whispers(records: List[AhamkaraRecord], limit: Int) {
    let total: Int = list_len(records);
    let mut shown: Int = 0;
    let mut i: Int = 0;
    while i < total && (limit == 0 || shown < limit) {
        let r: AhamkaraRecord = list_get(records, i);
        if chars_len(r.quote) > 0 {
            print_whisper_card(r);
            shown = shown + 1;
        }
        i = i + 1;
    }
    println("Displayed " + shown.to_string() + " paracausal whispers.");
}

pub fn cli_interactive_list(records: List[AhamkaraRecord], limit: Int) {
    let total: Int = list_len(records);
    let mut shown: Int = 0;
    let mut i: Int = 0;
    while i < total && (limit == 0 || shown < limit) {
        let r: AhamkaraRecord = list_get(records, i);
        print_record_summary(r);
        shown = shown + 1;
        i = i + 1;
    }
    print_results_summary(total, shown);
}

pub fn cli_interactive_search(records: List[AhamkaraRecord], term: String) {
    let kw: String = trim(term);
    if chars_len(kw) == 0 {
        println("Please provide a search term. Example: search Riven");
        return;
    }
    let total: Int = list_len(records);
    let mut matches: List[AhamkaraRecord] = list_new();
    let mut i: Int = 0;
    while i < total {
        let r: AhamkaraRecord = list_get(records, i);
        let hit_title: Bool = ic_match(r.title, kw);
        let hit_lore: Bool = ic_match(r.lore_text, kw);
        let hit_quote: Bool = ic_match(r.quote, kw);
        let hit_entity: Bool = ic_match(r.entity, kw);
        let hit_cat: Bool = ic_match(r.category, kw);
        if hit_title || hit_lore || hit_quote || hit_entity || hit_cat {
            matches = list_push(matches, r);
        }
        i = i + 1;
    }
    let n_matches: Int = list_len(matches);
    println("Search query: '" + kw + "' - found " + n_matches.to_string() + " matching records.\n");
    let mut mi: Int = 0;
    let max_disp: Int = 5;
    while mi < n_matches && mi < max_disp {
        print_record_card(list_get(matches, mi));
        mi = mi + 1;
    }
    if n_matches > max_disp {
        println("... and " + (n_matches - max_disp).to_string() + " more records. Refine your query for narrower results.");
    }
}

pub fn cli_interactive_entity(records: List[AhamkaraRecord], ent: String) {
    let target: String = trim(ent);
    if chars_len(target) == 0 {
        println("Please specify an entity. Example: entity Riven");
        return;
    }
    let total: Int = list_len(records);
    let mut matches: List[AhamkaraRecord] = list_new();
    let mut i: Int = 0;
    while i < total {
        let r: AhamkaraRecord = list_get(records, i);
        if ic_match(r.entity, target) {
            matches = list_push(matches, r);
        }
        i = i + 1;
    }
    let n_matches: Int = list_len(matches);
    println("Entity filter: '" + target + "' - found " + n_matches.to_string() + " records.\n");
    let mut mi: Int = 0;
    let max_disp: Int = 5;
    while mi < n_matches && mi < max_disp {
        print_record_card(list_get(matches, mi));
        mi = mi + 1;
    }
}

pub fn cli_interactive_category(records: List[AhamkaraRecord], cat: String) {
    let target: String = trim(cat);
    if chars_len(target) == 0 {
        println("Please specify a category. Example: category exotic_armor");
        return;
    }
    let total: Int = list_len(records);
    let mut matches: List[AhamkaraRecord] = list_new();
    let mut i: Int = 0;
    while i < total {
        let r: AhamkaraRecord = list_get(records, i);
        if ic_match(r.category, target) || ic_match(r.source, target) {
            matches = list_push(matches, r);
        }
        i = i + 1;
    }
    let n_matches: Int = list_len(matches);
    println("Category filter: '" + target + "' - found " + n_matches.to_string() + " records.\n");
    let mut mi: Int = 0;
    let max_disp: Int = 5;
    while mi < n_matches && mi < max_disp {
        print_record_card(list_get(matches, mi));
        mi = mi + 1;
    }
}

pub fn cli_interactive_eval(records: List[AhamkaraRecord], raw_input: String) -> Bool {
    let cmd: String = trim(raw_input);
    if chars_len(cmd) == 0 {
        return true;
    }
    if cmd == "quit" || cmd == "exit" {
        println("Exiting interactive lore explorer. 'Reality is the finest flesh, oh bearer mine.'");
        return false;
    }
    if cmd == "help" {
        print_interactive_help();
        return true;
    }
    if cmd == "stats" {
        cli_interactive_stats(records);
        return true;
    }
    if cmd == "whisper" {
        cli_interactive_whispers(records, 3);
        return true;
    }
    if cmd == "list" {
        cli_interactive_list(records, 15);
        return true;
    }
    if str_starts_with(cmd, "search ") {
        let term: String = str_slice(cmd, 7, chars_len(cmd));
        cli_interactive_search(records, term);
        return true;
    }
    if str_starts_with(cmd, "find ") {
        let term: String = str_slice(cmd, 5, chars_len(cmd));
        cli_interactive_search(records, term);
        return true;
    }
    if str_starts_with(cmd, "entity ") {
        let ent: String = str_slice(cmd, 7, chars_len(cmd));
        cli_interactive_entity(records, ent);
        return true;
    }
    if str_starts_with(cmd, "category ") {
        let cat: String = str_slice(cmd, 9, chars_len(cmd));
        cli_interactive_category(records, cat);
        return true;
    }
    println("Unknown command: '" + cmd + "'. Type 'help' for available commands or 'quit' to exit.");
    return true;
}

pub fn cli_run_interactive(records: List[AhamkaraRecord]) {
    println("============================================================");
    println("   Ahamkara Interactive Lore Explorer & Wisdom Interface    ");
    println("============================================================");
    let n: Int = list_len(records);
    println("Loaded " + n.to_string() + " canonical Ahamkara records.");
    println("Interactive session active. Type 'help' for command listing.");
    println("============================================================");
    println("");
    print_interactive_help();
    println("");
    println("--- Quick Discovery Showcase ---");
    cli_interactive_stats(records);
    println("");
    println("--- Featured Paracausal Whisper ---");
    cli_interactive_whispers(records, 1);
    println("");
    println("Interactive REPL session ready. Enter commands or 'exit' / 'quit' to finish.");
}
