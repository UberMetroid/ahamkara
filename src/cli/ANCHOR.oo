// # CLI Module Anchor
//
// Logline: Root module hub for Ahamkara terminal presentation and interactive REPL.
//
// Setup: Pure terminal presentation. Strictly 0 I/O capabilities required.
//
// Beats:
//   1. format.oo: Terminal lore card display, quote presentation, and result summaries.
//   2. interactive.oo: Terminal REPL session, interactive command dispatch, and discovery.

pub fn cli_version() -> String {
    return "0.5.1";
}

pub fn cli_anchor() -> String {
    return "src/cli";
}
