// # Safe JSON Parsing Utilities
//
// Logline: Safe JSON string and array extraction for Ahamkara lore records.
//
// Setup: Pure string operations; zero I/O and zero external dependencies.
//
// Beats:
//   1. json_extract_string: Extracts string fields handling escaped characters.
//   2. json_extract_array: Extracts string lists from JSON array fields safely.
//   3. json_extract_tags: Convenience extractor for the "tags" array field.
//   4. Compiler stem aliases: json_parse_string, json_parse_tags, json_parse_array.

// Extracts string value for a given key from a single JSON line.
// Properly decodes escape sequences: \", \\, \n, \t, \r.
// Returns empty string if key is missing or value is empty.
pub fn json_extract_string(line: String, key: String) -> String {
    let needle: String = "\"" + key + "\"";
    let n: Int = chars_len(line);
    let klen: Int = chars_len(needle);
    let mut i: Int = 0;
    while i + klen <= n {
        if str_slice(line, i, i + klen) == needle {
            let mut j: Int = i + klen;
            while j < n && (char_at(line, j) == " " || char_at(line, j) == "\t") {
                j = j + 1;
            }
            if j < n && char_at(line, j) == ":" {
                j = j + 1;
                while j < n && (char_at(line, j) == " " || char_at(line, j) == "\t") {
                    j = j + 1;
                }
                if j < n && char_at(line, j) == "\"" {
                    let mut k: Int = j + 1;
                    let mut buf: String = "";
                    while k < n {
                        let c: String = char_at(line, k);
                        if c == "\\" {
                            if k + 1 < n {
                                let nxt: String = char_at(line, k + 1);
                                if nxt == "\"" { buf = buf + "\""; }
                                else if nxt == "\\" { buf = buf + "\\"; }
                                else if nxt == "n" { buf = buf + "\n"; }
                                else if nxt == "t" { buf = buf + "\t"; }
                                else if nxt == "r" { buf = buf + "\r"; }
                                else { buf = buf + nxt; }
                                k = k + 2;
                            } else {
                                return buf;
                            }
                        } else if c == "\"" {
                            return buf;
                        } else {
                            buf = buf + c;
                            k = k + 1;
                        }
                    }
                    return buf;
                }
                return "";
            }
        }
        i = i + 1;
    }
    return "";
}

// Extracts a list of string elements from a JSON array for a given key.
// Properly handles brackets inside strings (e.g. "o [reader] mine").
pub fn json_extract_array(line: String, key: String) -> List[String] {
    let mut out: List[String] = list_new();
    let needle: String = "\"" + key + "\"";
    let n: Int = chars_len(line);
    let klen: Int = chars_len(needle);
    let mut i: Int = 0;
    while i + klen <= n {
        if str_slice(line, i, i + klen) == needle {
            let mut j: Int = i + klen;
            while j < n && (char_at(line, j) == " " || char_at(line, j) == "\t") {
                j = j + 1;
            }
            if j < n && char_at(line, j) == ":" {
                j = j + 1;
                while j < n && char_at(line, j) != "[" {
                    j = j + 1;
                }
                if j >= n { return out; }
                j = j + 1;
                let mut in_str: Bool = false;
                let mut escaped: Bool = false;
                let mut buf: String = "";
                let mut done: Bool = false;
                while j < n && !done {
                    let c: String = char_at(line, j);
                    if escaped {
                        if c == "\"" { buf = buf + "\""; }
                        else if c == "\\" { buf = buf + "\\"; }
                        else if c == "n" { buf = buf + "\n"; }
                        else if c == "t" { buf = buf + "\t"; }
                        else if c == "r" { buf = buf + "\r"; }
                        else { buf = buf + c; }
                        escaped = false;
                    } else if c == "\\" {
                        if in_str { escaped = true; }
                    } else if c == "\"" {
                        if in_str {
                            out = list_push(out, buf);
                            buf = "";
                            in_str = false;
                        } else {
                            in_str = true;
                        }
                    } else if !in_str && c == "]" {
                        done = true;
                    } else if in_str {
                        buf = buf + c;
                    }
                    j = j + 1;
                }
                return out;
            }
        }
        i = i + 1;
    }
    return out;
}

// Extracts tags list from "tags": ["tag1", "tag2", ...]
pub fn json_extract_tags(line: String) -> List[String] {
    return json_extract_array(line, "tags");
}

// Aliases matching json_parse stem for tc_unused_import compatibility
pub fn json_parse_string(line: String, key: String) -> String {
    return json_extract_string(line, key);
}

pub fn json_parse_array(line: String, key: String) -> List[String] {
    return json_extract_array(line, key);
}

pub fn json_parse_tags(line: String) -> List[String] {
    return json_extract_tags(line);
}
