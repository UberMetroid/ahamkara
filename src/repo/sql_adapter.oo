// # SQL Storage Adapter & Decoupling Layer
//
// Logline: Encapsulates openOODA sovereign database imports and query execution primitives.
//
// Setup: Decouples repo contracts from underlying database standard library import paths.
// Exposes schema construction, query execution, row extraction, and record hydration.
//
// Beats:
//   1. sql_adapter_create_table: Constructs SqlCreateTableStmt DDL schema.
//   2. sql_adapter_init_table: Initializes in-memory DbTable instance.
//   3. sql_adapter_select_by_id: Executes SELECT WHERE name = <id> with limit 1.
//   4. sql_adapter_select_all: Executes SELECT returning all active table rows.
//   5. sql_adapter_count: Executes SELECT query reporting rows_affected.
//   6. sql_adapter_parse_payload: Hydrates record from row payload string.
//   7. sql_adapter_check: Compiler stem anchor verifying import resolution.

import "std/app/data/database/sql_executor.oo";
import "std/app/data/database/sql_exec_dml.oo";
import "std/app/data/database/sql_ast.oo";
import "repo/loader.oo";
import "model/record.oo";

pub fn sql_adapter_create_table(name: String, cols: List[SqlColumnDef]) -> SqlCreateTableStmt {
    return sql_create_table_stmt_create(name, cols);
}

pub fn sql_adapter_init_table(name: String) -> DbTable {
    return db_table_create(name);
}

pub fn sql_adapter_column_def(name: String, data_type: String, is_pk: Bool, is_null: Bool) -> SqlColumnDef {
    return SqlColumnDef {
        name: name,
        data_type: data_type,
        is_primary_key: is_pk,
        is_nullable: is_null
    };
}

pub fn sql_adapter_storage_columns() -> List[String] {
    let mut cols: List[String] = list_new();
    cols = list_push(cols, "name");
    cols = list_push(cols, "role");
    return cols;
}

pub fn sql_adapter_execute(t: &mut DbTable, stmt: SqlStatement) -> DbQueryResult {
    return sql_execute_stmt(t, stmt);
}

pub fn sql_adapter_select_by_id(t: &mut DbTable, id: String) -> DbQueryResult {
    let cols: List[String] = sql_adapter_storage_columns();
    let mut sel: SqlSelectStmt = sql_select_stmt_create(t.table_name, cols);
    let mut ops: List[SqlBinaryOp] = list_new();
    ops = list_push(ops, SqlBinaryOp {
        op: "=",
        left_field: "name",
        right_val: id
    });
    sel.where_clause = ops;
    sel.limit_val = 1;
    let stmt: SqlStatement = sql_stmt_from_select(sel);
    return sql_execute_stmt(t, stmt);
}

pub fn sql_adapter_select_all(t: &mut DbTable) -> DbQueryResult {
    let cols: List[String] = sql_adapter_storage_columns();
    let sel: SqlSelectStmt = sql_select_stmt_create(t.table_name, cols);
    let stmt: SqlStatement = sql_stmt_from_select(sel);
    return sql_execute_stmt(t, stmt);
}

pub fn sql_adapter_count(t: &mut DbTable) -> Int {
    let mut cols: List[String] = list_new();
    cols = list_push(cols, "name");
    let sel: SqlSelectStmt = sql_select_stmt_create(t.table_name, cols);
    let stmt: SqlStatement = sql_stmt_from_select(sel);
    let qres: DbQueryResult = sql_execute_stmt(t, stmt);
    if qres.success {
        return qres.rows_affected;
    }
    return t.row_count;
}

pub fn sql_adapter_parse_payload(payload: String) -> Option[AhamkaraRecord] {
    return parse_record_line(payload);
}

pub fn sql_adapter_check() -> Bool {
    let _sample: Option[AhamkaraRecord] = loader_parse_record_line("");
    return true;
}
