// # Lore Repository Loader
//
// Logline: Loads canonical JSONL lore corpus into in-memory AhamkaraRecord list or DbTable.
//
// Setup: Granted FsReadCap to access filesystem; parses records via json_parse.oo; inserts into DbTable.
//
// Beats:
//   1. parse_record_line: Converts a single JSON line into Option[AhamkaraRecord].
//   2. repo_find_by_id: Finds a record by unique ID from a list of records.
//   3. repo_load_all: Reads corpus file under &FsReadCap returning Result[List[AhamkaraRecord], String].
//   4. repo_seed_table: Ingests corpus JSONL into relational DbTable using sql_execute_stmt.
//   5. Compiler stem aliases: loader_load_all, loader_find_by_id, loader_parse_record_line, loader_seed_table.

import "std/app/data/database/sql_executor.oo";
import "std/app/data/database/sql_exec_dml.oo";
import "std/app/data/database/sql_ast.oo";
import "model/record.oo";
import "repo/json_parse.oo";

pub fn parse_record_line(line: String) -> Option[AhamkaraRecord] {
    let id: String = json_extract_string(line, "id");
    if chars_len(id) == 0 {
        return None;
    }
    let title: String = json_extract_string(line, "title");
    if chars_len(title) == 0 {
        return None;
    }

    let mut cat: String = json_extract_string(line, "category");
    if chars_len(cat) == 0 {
        cat = json_extract_string(line, "type");
    }
    if chars_len(cat) == 0 {
        cat = json_extract_string(line, "theme");
    }

    let mut ent: String = json_extract_string(line, "entity");
    if chars_len(ent) == 0 {
        let ents: List[String] = json_extract_array(line, "entity");
        if list_len(ents) > 0 {
            ent = list_get(ents, 0);
        }
    }

    let mut src: String = json_extract_string(line, "source");
    if chars_len(src) == 0 {
        let src_type: String = json_extract_string(line, "type");
        let src_game: String = json_extract_string(line, "game");
        if chars_len(src_type) > 0 && chars_len(src_game) > 0 {
            src = src_type + " (" + src_game + ")";
        } else if chars_len(src_type) > 0 {
            src = src_type;
        } else {
            src = json_extract_string(line, "ishtar_url");
        }
    }

    let mut quote: String = json_extract_string(line, "quote");
    if chars_len(quote) == 0 {
        quote = json_extract_string(line, "speaker");
    }

    let mut lore: String = json_extract_string(line, "lore_text");
    if chars_len(lore) == 0 {
        lore = json_extract_string(line, "transcript");
    }

    let tags: List[String] = json_extract_tags(line);

    let rec: AhamkaraRecord = record_new(id, title, cat, ent, src, quote, lore, tags);
    if !record_is_valid(rec) {
        return None;
    }
    return Some(rec);
}

pub fn repo_find_by_id(records: List[AhamkaraRecord], id: String) -> Option[AhamkaraRecord] {
    let n: Int = list_len(records);
    let mut i: Int = 0;
    while i < n {
        let r: AhamkaraRecord = list_get(records, i);
        if r.id == id {
            return Some(r);
        }
        i = i + 1;
    }
    return None;
}

pub fn repo_load_all(fs: &FsReadCap, file_path: String) -> Result[List[AhamkaraRecord], String] {
    if !path_exists(fs, file_path) {
        return Err("ERR: lore corpus file not found: " + file_path);
    }
    let res: Result[String, String] = read_file(fs, file_path);
    if res.is_err() {
        return Err("ERR: failed to read lore corpus: " + file_path);
    }
    let raw: String = match res {
        Ok(s) => s,
        Err(e) => e
    };
    let mut out: List[AhamkaraRecord] = list_new();
    let n: Int = chars_len(raw);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        let is_nl: Bool = (i == n) || (char_at(raw, i) == "\n");
        if is_nl {
            if i > start {
                let line: String = str_slice(raw, start, i);
                let opt: Option[AhamkaraRecord] = parse_record_line(line);
                match opt {
                    Some(rec) => {
                        out = list_push(out, rec);
                    },
                    None => {}
                };
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return Ok(out);
}

pub fn repo_seed_table(fs: &FsReadCap, t: &mut DbTable, file_path: String) -> Result[Int, String] {
    if !path_exists(fs, file_path) {
        return Err("ERR: lore corpus file not found: " + file_path);
    }
    let res: Result[String, String] = read_file(fs, file_path);
    if res.is_err() {
        return Err("ERR: failed to read lore corpus: " + file_path);
    }
    let raw: String = match res {
        Ok(s) => s,
        Err(e) => e
    };
    let n: Int = chars_len(raw);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut count: Int = 0;

    let mut cols: List[String] = list_new();
    cols = list_push(cols, "name");
    cols = list_push(cols, "role");

    while i <= n {
        let is_nl: Bool = (i == n) || (char_at(raw, i) == "\n");
        if is_nl {
            if i > start {
                let line: String = str_slice(raw, start, i);
                let id: String = json_extract_string(line, "id");
                if chars_len(id) > 0 {
                    let mut vals: List[String] = list_new();
                    vals = list_push(vals, id);
                    vals = list_push(vals, line);
                    let ins: SqlInsertStmt = sql_insert_stmt_create(t.table_name, cols, vals);
                    let qres: DbQueryResult = sql_execute_stmt(t, sql_stmt_from_insert(ins));
                    if !qres.success {
                        return Err("ERR: failed to insert record '" + id + "': " + qres.error_msg);
                    }
                    count = count + 1;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return Ok(count);
}

// Aliases matching loader stem for tc_unused_import compatibility
pub fn loader_load_all(fs: &FsReadCap, file_path: String) -> Result[List[AhamkaraRecord], String] {
    return repo_load_all(fs, file_path);
}

pub fn loader_find_by_id(records: List[AhamkaraRecord], id: String) -> Option[AhamkaraRecord] {
    return repo_find_by_id(records, id);
}

pub fn loader_parse_record_line(line: String) -> Option[AhamkaraRecord] {
    return parse_record_line(line);
}

pub fn loader_seed_table(fs: &FsReadCap, t: &mut DbTable, file_path: String) -> Result[Int, String] {
    return repo_seed_table(fs, t, file_path);
}
