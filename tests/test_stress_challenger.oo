// # Empirical Stress Test Harness — Challenger 2
//
// Logline: Adversarial stress-testing of JSON parser, escapes, brackets, and corpus hydration.
//
// Setup: Runs without mocks; loads real corpus data/ahamkara_corpus.jsonl under &FsReadCap.

import "src/model/record.oo";
import "src/repo/json_parse.oo";
import "src/repo/loader.oo";

pub fn stress_test_escapes() -> Bool {
    let l1: String = "{\"q\": \"\\\"\\\"\"}";
    if json_extract_string(l1, "q") != "\"\"" { return false; }

    let l2: String = "{\"q\": \"\\\"O BEARER MINE.\\\"\"}";
    if json_extract_string(l2, "q") != "\"O BEARER MINE.\"" { return false; }

    let l3: String = "{\"p\": \"\\\\\\\\\"}";
    if json_extract_string(l3, "p") != "\\\\" { return false; }

    let l4: String = "{\"p\": \"a\\\\b\\\\\\\\c\"}";
    if json_extract_string(l4, "p") != "a\\b\\\\c" { return false; }

    let l5: String = "{\"txt\": \"a\\nb\\tc\\rd\"}";
    if json_extract_string(l5, "txt") != "a\nb\tc\rd" { return false; }

    let l6: String = "{\"txt\": \"escaped \\\\\\\"quote\\\\\\\" and \\\\n\"}";
    if json_extract_string(l6, "txt") != "escaped \\\"quote\\\" and \\n" { return false; }

    let l7: String = "{\"id\": \"unclosed";
    if json_extract_string(l7, "id") != "unclosed" { return false; }

    let l8: String = "{\"id\": \"trail\\";
    if json_extract_string(l8, "id") != "trail" { return false; }

    let l9: String = "{\"id\": \"\"}";
    if json_extract_string(l9, "id") != "" { return false; }

    let l10: String = "{\"other\": \"val\", \"id\": \"target\"}";
    if json_extract_string(l10, "id") != "target" { return false; }

    return true;
}

pub fn stress_test_brackets() -> Bool {
    let l1: String = "{\"tags\": [\"fourth-wall\", \"o [reader] mine\", \"o [player] mine\"]}";
    let t1: List[String] = json_extract_tags(l1);
    if list_len(t1) != 3 { return false; }
    if list_get(t1, 0) != "fourth-wall" { return false; }
    if list_get(t1, 1) != "o [reader] mine" { return false; }
    if list_get(t1, 2) != "o [player] mine" { return false; }

    let l2: String = "{\"tags\": [\"nested [brackets [deep]]\", \"normal\"]}";
    let t2: List[String] = json_extract_tags(l2);
    if list_len(t2) != 2 { return false; }
    if list_get(t2, 0) != "nested [brackets [deep]]" { return false; }
    if list_get(t2, 1) != "normal" { return false; }

    let l3: String = "{\"tags\": [\"tag with \\\"quotes\\\" inside\", \"t2\"]}";
    let t3: List[String] = json_extract_tags(l3);
    if list_len(t3) != 2 { return false; }
    if list_get(t3, 0) != "tag with \"quotes\" inside" { return false; }
    if list_get(t3, 1) != "t2" { return false; }

    let l4: String = "{\"tags\": [\"\", \"non-empty\", \"\"]}";
    let t4: List[String] = json_extract_tags(l4);
    if list_len(t4) != 3 { return false; }
    if list_get(t4, 0) != "" { return false; }
    if list_get(t4, 1) != "non-empty" { return false; }
    if list_get(t4, 2) != "" { return false; }

    let l5: String = "{\"tags\": [ \"spaced1\" , \"spaced2\" ]}";
    let t5: List[String] = json_extract_tags(l5);
    if list_len(t5) != 2 { return false; }
    if list_get(t5, 0) != "spaced1" { return false; }
    if list_get(t5, 1) != "spaced2" { return false; }

    let l6: String = "{\"tags\": []}";
    let t6: List[String] = json_extract_tags(l6);
    if list_len(t6) != 0 { return false; }

    let l7: String = "{\"tags\": [\"unclosed1\", \"unclosed2\"";
    let t7: List[String] = json_extract_tags(l7);
    if list_len(t7) != 2 { return false; }

    return true;
}

pub fn stress_test_missing_and_malformed() -> Bool {
    if chars_len(json_extract_string("", "id")) != 0 { return false; }
    if chars_len(json_extract_string("malformed json line", "id")) != 0 { return false; }
    if chars_len(json_extract_string("{\"title\": \"hello\"}", "id")) != 0 { return false; }
    if chars_len(json_extract_string("{\"identifier\": \"hello\"}", "id")) != 0 { return false; }

    let t_empty: List[String] = json_extract_tags("");
    if list_len(t_empty) != 0 { return false; }

    let t_malformed: List[String] = json_extract_tags("malformed line");
    if list_len(t_malformed) != 0 { return false; }

    let t_missing: List[String] = json_extract_tags("{\"id\": \"rec\"}");
    if list_len(t_missing) != 0 { return false; }

    return true;
}

pub fn stress_test_io_errors(fs: &FsReadCap) -> Bool {
    let r1: Result[List[AhamkaraRecord], String] = repo_load_all(fs, "data/nonexistent_file.jsonl");
    if r1.is_ok() { return false; }

    let r2: Result[List[AhamkaraRecord], String] = repo_load_all(fs, "");
    if r2.is_ok() { return false; }

    let r3: Result[List[AhamkaraRecord], String] = repo_load_all(fs, "/path/that/does/not/exist.jsonl");
    if r3.is_ok() { return false; }

    return true;
}

pub fn stress_test_corpus_hydration(fs: &FsReadCap) -> Bool {
    let res: Result[List[AhamkaraRecord], String] = repo_load_all(fs, "data/ahamkara_corpus.jsonl");
    if res.is_err() {
        println("FAIL: repo_load_all returned error");
        return false;
    }

    let mut pass: Bool = false;
    match res {
        Ok(recs) => {
            let total: Int = list_len(recs);
            if total != 84 {
                println("FAIL: expected 84 records");
                return false;
            }

            let mut count_valid: Int = 0;
            let mut count_riven: Int = 0;
            let mut count_taranis: Int = 0;
            let mut count_hefnd: Int = 0;
            let mut found_skull: Bool = false;

            let mut i: Int = 0;
            while i < total {
                let r: AhamkaraRecord = list_get(recs, i);

                if !record_is_valid(r) {
                    println("FAIL: record_is_valid returned false for: " + r.id);
                    return false;
                }

                if chars_len(r.id) == 0 || chars_len(r.title) == 0 || chars_len(r.lore_text) == 0 {
                    println("FAIL: empty mandatory field: " + r.id);
                    return false;
                }

                if r.entity == "Riven" { count_riven = count_riven + 1; }
                if r.entity == "Taranis" { count_taranis = count_taranis + 1; }
                if r.entity == "Hefnd" { count_hefnd = count_hefnd + 1; }

                if r.id == "exotic-skull-of-dire-ahamkara" {
                    found_skull = true;
                    if r.title != "Skull of Dire Ahamkara" {
                        println("FAIL: Skull title mismatch");
                        return false;
                    }
                    if !record_has_quote(r) {
                        println("FAIL: Skull should have quote");
                        return false;
                    }
                }

                count_valid = count_valid + 1;
                i = i + 1;
            }

            if count_valid == 84 && count_riven > 0 && count_taranis > 0 && count_hefnd > 0 && found_skull {
                pass = true;
            }
        },
        Err(err) => {
            println("FAIL: " + err);
            return false;
        }
    };

    return pass;
}

pub fn main(fs: &FsReadCap) {
    println("=== M3 Challenger 2 Stress Test Harness ===");

    if !stress_test_escapes() {
        println("FAIL: stress_test_escapes failed");
        process_exit(1);
    }
    println("PASS: stress_test_escapes (10/10 assertions)");

    if !stress_test_brackets() {
        println("FAIL: stress_test_brackets failed");
        process_exit(1);
    }
    println("PASS: stress_test_brackets (7/7 assertions)");

    if !stress_test_missing_and_malformed() {
        println("FAIL: stress_test_missing_and_malformed failed");
        process_exit(1);
    }
    println("PASS: stress_test_missing_and_malformed (7/7 assertions)");

    if !stress_test_io_errors(fs) {
        println("FAIL: stress_test_io_errors failed");
        process_exit(1);
    }
    println("PASS: stress_test_io_errors (3/3 assertions)");

    if !stress_test_corpus_hydration(fs) {
        println("FAIL: stress_test_corpus_hydration failed");
        process_exit(1);
    }
    println("PASS: stress_test_corpus_hydration (84/84 records valid, canonical entities verified)");

    println("OK: ALL_CHALLENGER_2_STRESS_TESTS_PASSED");
}
