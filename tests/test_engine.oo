// # Engine Unit Test Suite
//
// Logline: Comprehensive unit tests for search and stats engine modules.
//
// Setup: Tests contains_ic, record_matches_filter, engine_search, and stats aggregations.

import "src/model/record.oo";
import "src/model/query.oo";
import "src/engine/search.oo";
import "src/engine/stats.oo";

pub fn test_contains_ic_cases() -> Bool {
    if !contains_ic("Skull of Dire Ahamkara", "dire") { return false; }
    if !contains_ic("Skull of Dire Ahamkara", "DIRE") { return false; }
    if !contains_ic("Skull of Dire Ahamkara", "   dire   ") { return false; }
    if !contains_ic("Skull of Dire Ahamkara", "") { return false; }
    if !contains_ic("O [Reader] Mine", "[Reader]") { return false; }
    if !contains_ic("[The Queen]", "[The Queen]") { return false; }
    if contains_ic("Riven", "Taranis") { return false; }
    if contains_ic("", "something") { return false; }
    return true;
}

pub fn make_mock_record(id: String, title: String, ent: String, cat: String, src: String, quote: String, lore: String, tag1: String) -> AhamkaraRecord {
    let mut tags: List[String] = list_new();
    if chars_len(tag1) > 0 {
        tags = list_push(tags, tag1);
    }
    return record_new(id, title, cat, ent, src, quote, lore, tags);
}

pub fn test_filter_matching() -> Bool {
    let r1: AhamkaraRecord = make_mock_record("rec-1", "Skull of Dire Ahamkara", "Riven", "exotic_armor", "exotic_armor", "O Bearer Mine", "Bones of the dragon", "skull");
    let r2: AhamkaraRecord = make_mock_record("rec-2", "Young Ahamkaras Spine", "Taranis", "exotic_armor", "exotic_armor", "", "Spine of wish dragon", "spine");

    // Keyword match
    let mut f_kw: QueryFilter = filter_default();
    f_kw.keyword = "bearer";
    if !record_matches_filter(r1, f_kw) { return false; }
    if record_matches_filter(r2, f_kw) { return false; }

    // Entity match with whitespace
    let mut f_ent: QueryFilter = filter_default();
    f_ent.entity = "   riven   ";
    if !record_matches_filter(r1, f_ent) { return false; }
    if record_matches_filter(r2, f_ent) { return false; }

    // Category match
    let mut f_cat: QueryFilter = filter_default();
    f_cat.category = "exotic_armor";
    if !record_matches_filter(r1, f_cat) { return false; }
    if !record_matches_filter(r2, f_cat) { return false; }

    // Quote match
    let mut f_q: QueryFilter = filter_default();
    f_q.has_quote = true;
    if !record_matches_filter(r1, f_q) { return false; }
    if record_matches_filter(r2, f_q) { return false; }

    return true;
}

pub fn test_search_execution() -> Bool {
    let mut recs: List[AhamkaraRecord] = list_new();
    let r1: AhamkaraRecord = make_mock_record("r1", "Title One", "Riven", "armor", "src_armor", "Quote 1", "Lore text", "tag1");
    let r2: AhamkaraRecord = make_mock_record("r2", "Title Two", "Riven", "weapon", "src_weapon", "", "Lore text", "tag2");
    let r3: AhamkaraRecord = make_mock_record("r3", "Title Three", "Taranis", "armor", "src_armor", "Quote 3", "Lore text", "tag3");
    recs = list_push(recs, r1);
    recs = list_push(recs, r2);
    recs = list_push(recs, r3);

    // Empty filter returns all 3
    let res_all: List[AhamkaraRecord] = engine_search(recs, filter_default());
    if list_len(res_all) != 3 { return false; }

    // Entity filter returns 2
    let mut f_ent: QueryFilter = filter_default();
    f_ent.entity = "Riven";
    let res_ent: List[AhamkaraRecord] = engine_search(recs, f_ent);
    if list_len(res_ent) != 2 { return false; }

    // Limit filter returns 1
    let mut f_lim: QueryFilter = filter_default();
    f_lim.limit = 1;
    let res_lim: List[AhamkaraRecord] = engine_search(recs, f_lim);
    if list_len(res_lim) != 1 { return false; }

    // Convenience helpers
    let res_tar: List[AhamkaraRecord] = search_entity(recs, "Taranis");
    if list_len(res_tar) != 1 { return false; }
    let res_wep: List[AhamkaraRecord] = search_category(recs, "weapon");
    if list_len(res_wep) != 1 { return false; }
    let res_kw: List[AhamkaraRecord] = search_keyword(recs, "Three");
    if list_len(res_kw) != 1 { return false; }

    return true;
}

pub fn test_stats_analytics() -> Bool {
    let mut recs: List[AhamkaraRecord] = list_new();
    let r1: AhamkaraRecord = make_mock_record("r1", "T1", "Riven", "armor", "src1", "Q1", "L1", "muninn");
    let r2: AhamkaraRecord = make_mock_record("r2", "T2", "Huginn", "weapon", "src2", "", "L2", "muninn");
    recs = list_push(recs, r1);
    recs = list_push(recs, r2);

    let q: Int = count_quotes(recs);
    if q != 1 { return false; }
    let er: Int = count_by_entity(recs, "Riven");
    if er != 1 { return false; }
    let eh: Int = count_by_entity(recs, "Huginn");
    if eh != 1 { return false; }
    let em: Int = count_by_entity(recs, "Muninn");
    if em != 2 { return false; }
    let ca: Int = count_by_category(recs, "armor");
    if ca != 1 { return false; }
    let cw: Int = count_by_category(recs, "weapon");
    if cw != 1 { return false; }

    let st: RecordStats = engine_compute_stats(recs);
    if st.total_records != 2 { return false; }
    if st.total_quotes != 1 { return false; }

    return true;
}

pub fn run_all_engine_tests() -> Bool {
    if !test_contains_ic_cases() {
        println("FAIL: test_contains_ic_cases");
        return false;
    }
    if !test_filter_matching() {
        println("FAIL: test_filter_matching");
        return false;
    }
    if !test_search_execution() {
        println("FAIL: test_search_execution");
        return false;
    }
    if !test_stats_analytics() {
        println("FAIL: test_stats_analytics");
        return false;
    }
    return true;
}

pub fn test_engine_main() -> Bool {
    if !run_all_engine_tests() {
        println("ERR: test_engine assertions failed");
        return false;
    }
    println("OK: test_engine passed all test cases");
    return true;
}
