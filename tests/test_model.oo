// # Test Suite — openOODA Domain Models (Feature 8)
//
// Logline: Comprehensive unit tests for AhamkaraRecord and QueryFilter models.
//
// Setup: Validates struct construction, field access, validity checks, and default filters.
//
// Beats:
//   1. test_record_creation: Validate AhamkaraRecord field hydration.
//   2. test_record_is_valid: Assert valid record returns true.
//   3. test_record_invalid_cases: Assert empty id, title, or lore_text returns false.
//   4. test_filter_default: Assert QueryFilter default initialization.
//   5. test_filter_custom: Assert custom QueryFilter field values.
//   6. main: Test runner entry point reporting result.

import "src/model/record.oo";
import "src/model/query.oo";

pub fn test_record_creation() -> Bool {
    let mut tags: List[String] = list_new();
    tags = list_push(tags, "exotic");
    tags = list_push(tags, "armor");

    let r: AhamkaraRecord = record_new(
        "exotic-skull-of-dire-ahamkara",
        "Skull of Dire Ahamkara",
        "exotic_armor",
        "General Ahamkara",
        "Destiny 2",
        "O BEARER MINE.",
        "What kind of talking skull would address its host that way?",
        tags
    );

    if r.id != "exotic-skull-of-dire-ahamkara" { return false; }
    if r.title != "Skull of Dire Ahamkara" { return false; }
    if r.category != "exotic_armor" { return false; }
    if r.entity != "General Ahamkara" { return false; }
    if r.source != "Destiny 2" { return false; }
    if r.quote != "O BEARER MINE." { return false; }
    if r.lore_text != "What kind of talking skull would address its host that way?" { return false; }
    if list_len(r.tags) != 2 { return false; }
    if list_get(r.tags, 0) != "exotic" { return false; }
    if list_get(r.tags, 1) != "armor" { return false; }
    return true;
}

pub fn test_record_is_valid() -> Bool {
    let mut tags: List[String] = list_new();
    tags = list_push(tags, "test");
    let valid_rec: AhamkaraRecord = record_new(
        "rec-01",
        "Valid Title",
        "Lore Book",
        "Riven",
        "Destiny 2",
        "Whisper",
        "Lore text content here.",
        tags
    );
    return record_is_valid(valid_rec);
}

pub fn test_record_invalid_empty_id() -> Bool {
    let mut tags: List[String] = list_new();
    let r: AhamkaraRecord = record_new(
        "",
        "Valid Title",
        "Category",
        "Entity",
        "Source",
        "",
        "Valid lore text.",
        tags
    );
    return !record_is_valid(r);
}

pub fn test_record_invalid_empty_title() -> Bool {
    let mut tags: List[String] = list_new();
    let r: AhamkaraRecord = record_new(
        "rec-02",
        "",
        "Category",
        "Entity",
        "Source",
        "",
        "Valid lore text.",
        tags
    );
    return !record_is_valid(r);
}

pub fn test_record_invalid_empty_lore_text() -> Bool {
    let mut tags: List[String] = list_new();
    let r: AhamkaraRecord = record_new(
        "rec-03",
        "Valid Title",
        "Category",
        "Entity",
        "Source",
        "",
        "",
        tags
    );
    return !record_is_valid(r);
}

pub fn test_filter_default() -> Bool {
    let f: QueryFilter = filter_default();
    if f.keyword != "" { return false; }
    if f.entity != "" { return false; }
    if f.category != "" { return false; }
    if f.has_quote != false { return false; }
    if f.limit != 0 { return false; }
    if f.has_explicit_limit != false { return false; }
    return true;
}

pub fn test_filter_custom() -> Bool {
    let mut f: QueryFilter = filter_default();
    f.keyword = "O [Reader] Mine";
    f.entity = "Riven";
    f.category = "Exotic Armor";
    f.has_quote = true;
    f.limit = 10;
    f.has_explicit_limit = true;

    if f.keyword != "O [Reader] Mine" { return false; }
    if f.entity != "Riven" { return false; }
    if f.category != "Exotic Armor" { return false; }
    if !f.has_quote { return false; }
    if f.limit != 10 { return false; }
    if !f.has_explicit_limit { return false; }
    return true;
}

pub fn run_all_model_tests() -> Bool {
    if !test_record_creation() {
        println("FAIL: test_record_creation");
        return false;
    }
    if !test_record_is_valid() {
        println("FAIL: test_record_is_valid");
        return false;
    }
    if !test_record_invalid_empty_id() {
        println("FAIL: test_record_invalid_empty_id");
        return false;
    }
    if !test_record_invalid_empty_title() {
        println("FAIL: test_record_invalid_empty_title");
        return false;
    }
    if !test_record_invalid_empty_lore_text() {
        println("FAIL: test_record_invalid_empty_lore_text");
        return false;
    }
    if !test_filter_default() {
        println("FAIL: test_filter_default");
        return false;
    }
    if !test_filter_custom() {
        println("FAIL: test_filter_custom");
        return false;
    }
    return true;
}

pub fn test_model_main() -> Bool {
    if !run_all_model_tests() {
        println("ERR: test_model assertions failed");
        return false;
    }
    println("OK: test_model passed all 7 test cases");
    return true;
}

