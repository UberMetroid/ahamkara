// # Test Suite for ahamkara
//
// Logline: Starter unit tests for ahamkara.
//
// Setup: Verifies basic test assertion infrastructure.
//
// Beats:
//   1. Run basic assertions.

pub fn test_basic_addition() -> Bool {
    let sum: Int = 2 + 2;
    if sum == 4 {
        return true;
    }
    return false;
}

pub fn main() {
    if !test_basic_addition() {
        println("FAIL: basic test");
        process_exit(1);
    }
    println("OK: ALL_TESTS_PASSED");
}
