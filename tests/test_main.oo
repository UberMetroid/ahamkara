// # Master Test Runner Suite
//
// Logline: Orchestrates all openOODA unit tests for the Ahamkara query engine.
//
// Setup: Executes test suites from test_model.oo, test_repo.oo, test_db_sql.oo, test_engine.oo, and test_cli.oo.
//
// Beats:
//   1. Run test_model suite.
//   2. Run test_repo suite (pure and file-loaded).
//   3. Run test_db_sql suite (schema DDL, seed loader, and DbTable storage).
//   4. Run test_engine suite.
//   5. Run test_cli suite.

import "tests/test_model.oo";
import "tests/test_repo.oo";
import "tests/test_db_sql.oo";
import "tests/test_engine.oo";
import "tests/test_cli.oo";

pub fn main(fs: &FsReadCap) {
    println("Running Ahamkara Unit Test Suites...");

    if !run_all_model_tests() {
        println("FAIL: model test suite failed");
        process_exit(1);
    }
    println("PASS: model test suite");

    if !run_pure_repo_tests() {
        println("FAIL: pure repo test suite failed");
        process_exit(1);
    }
    if !test_repo_load_missing_file(fs) {
        println("FAIL: test_repo_load_missing_file failed");
        process_exit(1);
    }
    if !test_repo_load_corpus(fs) {
        println("FAIL: test_repo_load_corpus failed");
        process_exit(1);
    }
    println("PASS: repo test suite");

    if !run_all_db_sql_tests(fs) {
        println("FAIL: db_sql test suite failed");
        process_exit(1);
    }
    println("PASS: db_sql test suite");

    if !run_all_engine_tests() {
        println("FAIL: engine test suite failed");
        process_exit(1);
    }
    println("PASS: engine test suite");

    if !run_all_cli_tests() {
        println("FAIL: cli test suite failed");
        process_exit(1);
    }
    println("PASS: cli test suite");

    println("OK: ALL_TESTS_PASSED");
}
