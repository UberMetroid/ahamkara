// # Test Suite — Anchor for Agents
//
// Logline: Root test runner and verification suite for Ahamkara query engine.
// Version: 1.1.0
//
// Setup: Exercises domain models, repository parsers, db_sql storage, search engine, and CLI formatters.
//
// Beats:
//   1. test_main.oo: Core test runner executing all unit tests.
//   2. test_model.oo: Tests domain record validation and query filters.
//   3. test_parser.oo: Tests JSONL extraction utilities.
//   4. test_engine.oo: Tests case-insensitive substring search and attribute filtering.
//   5. test_repo.oo: Tests corpus file loading and record hydration.
//   6. test_db_sql.oo: Tests relational schema DDL, DbTable seed loader, and row count invariants.

pub fn tests_version() -> String {
    return "1.1.0";
}
